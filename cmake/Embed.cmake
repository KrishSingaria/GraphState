function(gs_embed OUT_FILE IN_PATH)
  get_filename_component(OUT_DIR "${OUT_FILE}" DIRECTORY)
  file(MAKE_DIRECTORY "${OUT_DIR}")

  set(EMBEDDED_ENTRIES "")
  if(IS_DIRECTORY "${IN_PATH}")
    file(GLOB_RECURSE FOUND_FILES "${IN_PATH}/*")
    foreach(F IN LISTS FOUND_FILES)
      if(NOT IS_DIRECTORY "${F}")
        file(RELATIVE_PATH REL "${IN_PATH}" "${F}")
        string(REPLACE "\\" "/" REL "${REL}")
        file(READ "${F}" CONTENT)
        string(APPEND EMBEDDED_ENTRIES "  {\"${REL}\", R\"_GS_EMBED_(${CONTENT})_GS_EMBED_\"},\n")
      endif()
    endforeach()
  endif()

  set(FILE_CONTENTS "// Generated by gs_embed - DO NOT EDIT\n#pragma once\n#include <string_view>\n\nnamespace gs::embedded {\nstruct Entry {\n  std::string_view path;\n  std::string_view content;\n};\n\ninline constexpr Entry HOST_KITS[] = {\n${EMBEDDED_ENTRIES}};\n}\n")
  file(WRITE "${OUT_FILE}" "${FILE_CONTENTS}")
endfunction()
